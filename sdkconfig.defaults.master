# Master image: existing OBD/TPMS/media application plus two UART transmitters.
CONFIG_GAUGE_FIRMWARE_MASTER=y
# CONFIG_GAUGE_FIRMWARE_SLAVE is not set
# CONFIG_GAUGE_BOARD_LCD185 is not set
CONFIG_OBD_HW_VERSION_V1_WAVESHARE=y
# Console uses the native USB Serial/JTAG peripheral. UART0 remains available
# to the existing RS485 brake-temperature module.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART is not set
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_CONSOLE_UART is not set
# CONFIG_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
# TinyUSB is started only in the dedicated SD file-transfer boot mode.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=512
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=64
CONFIG_TINYUSB_CDC_TX_BUFSIZE=64
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
CONFIG_TINYUSB_DESC_PRODUCT_STRING="SkyGauge SD Transfer"
CONFIG_TINYUSB_DESC_SERIAL_STRING=""
