# Slave image: LCD/UI + UART receiver only.
# CONFIG_GAUGE_FIRMWARE_MASTER is not set
CONFIG_GAUGE_FIRMWARE_SLAVE=y
CONFIG_GAUGE_BOARD_LCD185=y
CONFIG_OBD_HW_VERSION_V1_WAVESHARE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART is not set
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_CONSOLE_UART is not set
# CONFIG_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
